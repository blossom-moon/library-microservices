<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Aspire-інтеграція: реєструє IConnection (singleton), health check і телеметрію; тягне RabbitMQ.Client 7.x -->
    <PackageReference Include="Aspire.RabbitMQ.Client" Version="13.*" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- CorrelationContext і Serilog LogContext -->
    <ProjectReference Include="..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
