{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "aggregator": {
        "ClusterId": "aggregator",
        "Order": 1,
        "Match": {
          "Path": "/api/aggregator/{**catch-all}"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "loans": {
        "ClusterId": "loans",
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "loans",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "readers": {
        "ClusterId": "loans",
        "Match": {
          "Path": "/api/readers/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "loans",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "books": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/books/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "authors": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/authors/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "Metadata": {
          "Team": "catalog",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "reviews": {
        "ClusterId": "reviews",
        "Match": {
          "Path": "/api/reviews/{**catch-all}"
        },
        "MaxRequestBodySize": 1048576,
        "Metadata": {
          "Team": "reviews",
          "Version": "v1"
        },
        "AuthorizationPolicy": "authenticated"
      },
      "auth-public": {
        "ClusterId": "auth",
        "Order": 0,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/auth/{**catch-all}",
          "Methods": [
            "POST"
          ]
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "auth-protected": {
        "ClusterId": "auth",
        "Order": 2,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "users": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/users/{**catch-all}"
        },
        "Metadata": {
          "Team": "auth"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "Metadata": {
          "Team": "payments"
        }
      }
    },
    "Clusters": {
      "aggregator": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://aggregator"
          }
        }
      },
      "loans": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://loans-api"
          }
        }
      },
      "catalog": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "d1": {
            "Address": "http://catalog-api"
          }
        }
      },
      "reviews": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://reviews-api"
          }
        }
      },
      "auth": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://auth-api"
          }
        }
      },
      "payments": {
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://payments-api"
          }
        }
      }
    }
  }
}