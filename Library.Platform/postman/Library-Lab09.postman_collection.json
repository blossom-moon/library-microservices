    {
      "name": "2. IdentityServer (OAuth 2.0)",
      "item": [
        {
          "name": "Authorization Code + PKCE → access token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/books",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "description": "Вкладка Authorization: OAuth 2.0 → Grant type \"Authorization Code (With PKCE)\"; Auth URL http://localhost:5400/connect/authorize; Access Token URL http://localhost:5400/connect/token; Client ID postman; Client Secret = Clients:PostmanSecret; Scope \"openid profile roles catalog.read loans.read offline_access\"; Callback https://oauth.pstmn.io/v1/callback. Після Get New Access Token — Use Token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 з токеном IdentityServer', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Client Credentials → access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "http://localhost:5400/connect/token",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5400",
              "path": [
                "connect",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "client_id=aggregator_service, grant_type=client_credentials, scope=\"loans.read catalog.read reviews.read\" (urlencoded)",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                },
                {
                  "key": "client_id",
                  "value": "aggregator_service"
                },
                {
                  "key": "client_secret",
                  "value": "{{aggregatorSecret}}"
                },
                {
                  "key": "scope",
                  "value": "loans.read catalog.read reviews.read"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('m2mToken', j.access_token);",
                  "pm.test('токен без sub (машина-машина)', () => { const p = JSON.parse(atob(j.access_token.split('.')[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(p.sub).to.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Call API with Client Credentials token (GET books)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/books",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('M2M scope catalog.read → 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Call API with Client Credentials token (POST books, expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/books",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('немає scope catalog.create → 403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{m2mToken}}",
            "type": "string"
          }
        ]
      }
    },
