{
  "info": {
    "name": "Library Lab09 — Auth",
    "_postman_id": "9e29990b-e98c-4d30-be3b-0cf1058ce848",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Identity+JWT, IdentityServer (Authorization Code+PKCE, Client Credentials), Keycloak. Запуск: AppHost + pulumi up; змінні — на вкладці Variables."
  },
  "item": [
    {
      "name": "1. Identity + JWT (Auth Service)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/register",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"reader1\",\n  \"email\": \"reader1@library.local\",\n  \"password\": \"Reader#12345\",\n  \"fullName\": \"Reader One\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('verifyToken', j.devVerificationToken);",
                  "pm.collectionVariables.set('verifyEmail','reader1@library.local');",
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/verify-email",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{verifyEmail}}\",\n  \"token\": \"{{verifyToken}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/auth/login",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userNameOrEmail\": \"reader1\",\n  \"password\": \"Reader#12345\"\n}"
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Access token у тілі, refresh token — у HttpOnly cookie refreshToken (Postman зберігає cookie автоматично)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('localToken', j.accessToken);",
                  "pm.test('access token received', () => pm.expect(j.accessToken).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
