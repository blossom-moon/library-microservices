<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 06: gRPC-сервер (містить Google.Protobuf і Grpc.Tools) та Redis як IDistributedCache через Aspire -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.*" />
    <!-- Лаб. 07: health checks SQL Server і Redis -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.*" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Контракт — сервер (Aggregator підключає цей самий файл як Client) -->
    <Protobuf Include="Protos\catalog.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library.Catalog.Bll\Library.Catalog.Bll.csproj" />
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Platform.Security\Platform.Security.csproj" />
  </ItemGroup>

</Project>
