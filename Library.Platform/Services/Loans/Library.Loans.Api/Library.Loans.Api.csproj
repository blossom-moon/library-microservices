<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 06: gRPC-сервер (містить Google.Protobuf і Grpc.Tools) -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
    <!-- Лаб. 07: health check SQL Server -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" Version="9.*" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\loans.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Library.Loans.Bll\Library.Loans.Bll.csproj" />
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\..\Platform.Security\Platform.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 10: той самий скрипт, що й у WithCreationScript (AppHost), вбудований у збірку -->
    <EmbeddedResource Include="..\..\..\Platform.AppHost\db\loans-init.sql" LogicalName="loans-init.sql" />
  </ItemGroup>

</Project>
